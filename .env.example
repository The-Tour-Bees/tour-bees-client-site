# MongoDB connection string. MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tourbees
# Local: mongodb://127.0.0.1:27017/tourbees
MONGODB_URI=

# Random string of at least 32 characters used to sign sign-in cookies: openssl rand -base64 32
AUTH_SECRET=

# Optional: a webhook that sends SMS or email. We POST { channel, to, message } as JSON.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# Set to true to ask for a one-time code on every sign-in (default: first sign-in only)
OTP_EVERY_LOGIN=
