# MongoDB connection string. MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tourbees
# Local: mongodb://127.0.0.1:27017/tourbees
MONGODB_URI=

# Random string of at least 32 characters used to sign sign-in cookies: openssl rand -base64 32
AUTH_SECRET=

# Optional: a webhook that receives two kinds of JSON POST (see README, "Notifications"):
#   messages to send:        { channel, to, message }
#   new bookings/enquiries:  { type, id, name, contact: { mobile, email }, item, date }
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# Set to true to ask for a one-time code on every sign-in (default: first sign-in only)
OTP_EVERY_LOGIN=

# Optional: Cloudflare Turnstile spam check on the enquiry and guest-booking forms. Set both or neither:
# a secret key without a site key rejects every submission. The site key is built into the pages,
# so rebuild (redeploy) after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
